    <item>
      <title>Version 1.2</title>
      <link>https://github.com/harqian/Pause</link>
      <sparkle:version>1.2</sparkle:version>
      <sparkle:shortVersionString>1.2</sparkle:shortVersionString>
      <description>
        <![CDATA[
          <h2>What's New</h2>
          <ul>
            <li>simpler settings: 4 tabs instead of 7</li>
            <li>menu bar option to start a nogo on its own</li>
            <li>removed random timer and doom scroll detection</li>
            <li>fixed hide-from-dock not applying at launch</li>
            <li>much smaller download (21 MB, was 46 MB)</li>
          </ul>
        ]]>
      </description>
